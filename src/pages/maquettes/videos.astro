---
// Maquettes temporaires : intégration de deux vidéos sur /conferences/remi-guyot. Non publiées.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';

const videos = [
  {
    id: 'R_Q3WRkIcQw',
    kind: 'Keynote',
    title: 'L’IA au service de l’humain',
    source: 'eXalt · VISI[ON]S 2025',
    thumb: 'https://i.ytimg.com/vi/R_Q3WRkIcQw/sddefault.jpg',
  },
  {
    id: 'uuHs5wruwkk',
    kind: 'Podcast',
    title: 'Quand l’IA fait le produit, que manage-t-on encore ?',
    source: 'Le podcast Incenteev · Soft Revolution',
    thumb: 'https://i.ytimg.com/vi/uuHs5wruwkk/maxresdefault.jpg',
  },
];
const [keynote, podcast] = videos;

const options = [
  { n: 1, name: 'Vedette', where: 'Colonne de droite, tout en haut (avant la bio)', idea: 'La keynote en grand, avec le titre posé sur l’image, et le podcast en carte compacte en dessous. Le visiteur voit Rémi sur scène avant même de lire.' },
  { n: 2, name: 'Duo', where: 'Nouvelle carte « Le voir en action », après les thèmes', idea: 'Deux vignettes égales côte à côte, avec une pastille de format (Keynote, Podcast), le titre et la source. Sobre, dans le style des autres cartes.' },
  { n: 3, name: 'Duotone', where: 'Nouvelle carte, après les thèmes', idea: 'Les vignettes passent en noir et blanc teinté rose, comme le portrait de Rémi : les couleurs orange et turquoise des vignettes YouTube ne jurent plus avec la charte. La couleur revient au survol.' },
  { n: 4, name: 'Cinéma', where: 'Bande noire pleine largeur, sous la grille', idea: 'Un grand lecteur à gauche et une mini-playlist à droite : cliquer sur une vidéo de la liste la charge dans le lecteur. Effet « salle de projection », dans la lignée des bandeaux noirs du site.' },
];
---

<BaseLayout title="Maquettes vidéos · Rémi Guyot" description="Maquettes" noindex={true}>
  <Header />
  <main class="bg-surface-secondary pb-24">
    <div class="mx-auto max-w-7xl px-6 pt-14 md:px-8 lg:px-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">Maquettes · non publiées</p>
      <h1 class="mt-3 text-display-lg font-bold text-ink">Intégrer les vidéos de Rémi</h1>
      <p class="mt-4 max-w-3xl text-ink-muted">
        Quatre propositions pour la page conférencier. Dans toutes, la vidéo ne se charge qu’au clic (on affiche d’abord une simple image) :
        la page reste rapide et YouTube ne dépose pas de cookies tant que personne ne lance la lecture. Cliquez sur une vignette pour tester.
      </p>
      <nav class="mt-6 flex flex-wrap gap-2" aria-label="Options">
        {options.map((o) => <a href={`#option-${o.n}`} class="rounded-pill bg-white px-4 py-2 text-sm font-medium text-ink shadow-card hover:text-brand-600">{o.n} · {o.name}</a>)}
      </nav>
    </div>

    {options.map((o) => (
      <section id={`option-${o.n}`} class="mx-auto mt-16 max-w-7xl scroll-mt-28 px-6 md:px-8 lg:px-12">
        <div class="mb-6 max-w-3xl border-l-4 border-brand-500 pl-5">
          <p class="text-sm font-bold text-brand-600">Option {o.n}</p>
          <h2 class="text-3xl font-bold text-ink">{o.name}</h2>
          <p class="mt-1 text-sm font-medium text-ink-light">Emplacement : {o.where}</p>
          <p class="mt-3 text-ink-muted">{o.idea}</p>
        </div>

        {o.n === 1 && (
          <!-- Largeur de la colonne de droite de la page -->
          <div class="max-w-[820px] space-y-4 lg:ml-[436px]">
            <article class="overflow-hidden rounded-3xl bg-ink shadow-card-hover">
              <div class="yt group relative aspect-video" data-id={keynote.id}>
                <img src={keynote.thumb} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
                <button type="button" class="yt-play absolute inset-0 flex items-center justify-center focus:outline-none focus-visible:ring-4 focus-visible:ring-inset focus-visible:ring-brand-500" aria-label={`Lire la vidéo : ${keynote.title}`}>
                  <span class="flex h-20 w-20 items-center justify-center rounded-full bg-brand-500 text-white shadow-card-hover transition-transform group-hover:scale-110">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                </button>
                <div class="pointer-events-none absolute inset-x-0 bottom-0 p-6 text-white md:p-8">
                  <p class="text-xs font-semibold uppercase tracking-widest text-brand-400">Rémi sur scène · {keynote.kind}</p>
                  <h3 class="mt-2 text-2xl font-bold md:text-3xl">{keynote.title}</h3>
                  <p class="mt-1 text-sm text-white/70">{keynote.source}</p>
                </div>
              </div>
            </article>
            <article class="yt-card flex items-center gap-5 rounded-3xl bg-white p-4 shadow-card">
              <div class="yt group relative aspect-video w-40 shrink-0 overflow-hidden rounded-2xl sm:w-52" data-id={podcast.id}>
                <img src={podcast.thumb} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
                <button type="button" class="yt-play absolute inset-0 flex items-center justify-center bg-black/20 focus:outline-none focus-visible:ring-4 focus-visible:ring-inset focus-visible:ring-brand-500" aria-label={`Lire la vidéo : ${podcast.title}`}>
                  <span class="flex h-11 w-11 items-center justify-center rounded-full bg-white/95 text-brand-600 transition-transform group-hover:scale-110"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg></span>
                </button>
              </div>
              <div class="min-w-0">
                <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-light">{podcast.kind}</p>
                <h3 class="mt-1 font-semibold leading-snug text-ink">{podcast.title}</h3>
                <p class="mt-1 text-sm text-ink-muted">{podcast.source}</p>
              </div>
            </article>
          </div>
        )}

        {o.n === 2 && (
          <div class="max-w-[820px] rounded-3xl bg-white p-8 shadow-card md:p-10 lg:ml-[436px]">
            <h3 class="text-2xl font-bold text-ink">Le voir en action</h3>
            <p class="mt-2 text-sm text-ink-light">Une keynote et un podcast, pour se faire une idée du ton.</p>
            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              {videos.map((v) => (
                <article>
                  <div class="yt group relative aspect-video overflow-hidden rounded-2xl bg-ink" data-id={v.id}>
                    <img src={v.thumb} alt="" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                    <span class="pointer-events-none absolute left-3 top-3 z-10 rounded-pill bg-white px-3 py-1 text-xs font-semibold text-ink">{v.kind}</span>
                    <button type="button" class="yt-play absolute inset-0 flex items-center justify-center bg-black/10 focus:outline-none focus-visible:ring-4 focus-visible:ring-inset focus-visible:ring-brand-500" aria-label={`Lire la vidéo : ${v.title}`}>
                      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-500 text-white shadow-card-hover transition-transform group-hover:scale-110"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg></span>
                    </button>
                  </div>
                  <h4 class="mt-4 font-semibold leading-snug text-ink">{v.title}</h4>
                  <p class="mt-1 text-sm text-ink-muted">{v.source}</p>
                </article>
              ))}
            </div>
          </div>
        )}

        {o.n === 3 && (
          <div class="max-w-[820px] rounded-3xl bg-white p-8 shadow-card md:p-10 lg:ml-[436px]">
            <h3 class="text-2xl font-bold text-ink">Le voir en action</h3>
            <div class="mt-6 divide-y divide-gray-200">
              {videos.map((v, i) => (
                <article class={`grid items-center gap-6 sm:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] ${i === 0 ? 'pb-6' : 'pt-6'}`}>
                  <div class="yt duo group relative aspect-video overflow-hidden rounded-2xl bg-brand-500" data-id={v.id}>
                    <img src={v.thumb} alt="" class="absolute inset-0 h-full w-full object-cover grayscale contrast-125 mix-blend-multiply transition duration-500 group-hover:mix-blend-normal group-hover:grayscale-0" loading="lazy" />
                    <button type="button" class="yt-play absolute inset-0 flex items-center justify-center focus:outline-none focus-visible:ring-4 focus-visible:ring-inset focus-visible:ring-ink" aria-label={`Lire la vidéo : ${v.title}`}>
                      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-ink text-white transition-transform group-hover:scale-110"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg></span>
                    </button>
                  </div>
                  <div class="min-w-0">
                    <p class="text-[11px] font-semibold uppercase tracking-widest text-brand-700">{v.kind}</p>
                    <h4 class="mt-2 text-xl font-bold leading-snug text-ink">{v.title}</h4>
                    <p class="mt-2 text-sm text-ink-muted">{v.source}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}

        {o.n === 4 && (
          <div class="-mx-6 bg-ink text-white md:-mx-8 lg:-mx-12">
            <div class="cinema grid gap-8 px-6 py-14 md:px-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:px-12">
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-brand-500">Le voir en action</p>
                <div class="yt cinema-player group relative mt-4 aspect-video overflow-hidden rounded-2xl bg-black" data-id={videos[0].id}>
                  <img src={videos[0].thumb} alt="" class="cinema-thumb absolute inset-0 h-full w-full object-cover opacity-80" />
                  <button type="button" class="yt-play absolute inset-0 flex items-center justify-center focus:outline-none focus-visible:ring-4 focus-visible:ring-inset focus-visible:ring-brand-500" aria-label="Lire la vidéo">
                    <span class="flex h-20 w-20 items-center justify-center rounded-full bg-brand-500 text-white transition-transform group-hover:scale-110"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg></span>
                  </button>
                </div>
              </div>
              <div class="lg:pt-8">
                <ul class="space-y-3">
                  {videos.map((v, i) => (
                    <li>
                      <button type="button" class="cinema-item flex w-full items-center gap-4 rounded-2xl p-3 text-left transition-colors hover:bg-white/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 aria-pressed:bg-white/10" aria-pressed={i === 0 ? 'true' : 'false'} data-id={v.id} data-thumb={v.thumb}>
                        <img src={v.thumb} alt="" class="aspect-video w-32 shrink-0 rounded-lg object-cover" loading="lazy" />
                        <span class="min-w-0">
                          <span class="block text-[11px] font-semibold uppercase tracking-widest text-brand-400">{v.kind}</span>
                          <span class="mt-1 block text-sm font-semibold leading-snug">{v.title}</span>
                          <span class="mt-1 block text-xs text-white/60">{v.source}</span>
                        </span>
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        )}
      </section>
    ))}
  </main>
</BaseLayout>

<script>
  // Lecteur « léger » : l’iframe YouTube (sans cookie) n’est créée qu’au clic.
  const load = (box: HTMLElement) => {
    const id = box.dataset.id;
    box.innerHTML = `<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="Vidéo YouTube" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
  };
  document.querySelectorAll<HTMLButtonElement>('.yt-play').forEach((b) =>
    b.addEventListener('click', () => load(b.closest('.yt') as HTMLElement)),
  );
  // Option Cinéma : la playlist charge la vidéo choisie dans le grand lecteur.
  const player = document.querySelector<HTMLElement>('.cinema-player');
  document.querySelectorAll<HTMLButtonElement>('.cinema-item').forEach((item) =>
    item.addEventListener('click', () => {
      document.querySelectorAll('.cinema-item').forEach((i) => i.setAttribute('aria-pressed', String(i === item)));
      if (player) {
        player.dataset.id = item.dataset.id;
        load(player);
      }
    }),
  );
</script>
