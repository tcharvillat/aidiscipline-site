import TrainingDayLayout from '../../layouts/TrainingDayLayout.astro';

const TITLE = 'Faire de Claude Code son environnement de travail de PM';
const SLUG = 'claude-code-environnement-pm';

const objectives = [
  {
    title: 'Configurer et piloter Claude Code',
    body:
