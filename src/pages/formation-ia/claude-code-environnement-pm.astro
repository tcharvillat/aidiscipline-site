      "Plugins et marketplaces : installer en sécurité, partager en équipe",
    ],
  },
  {
    number: '04',
    title: 'Automatiser avec des agents',
    intro:
      "Confiez une partie du cycle de développement d'une fonctionnalité à des agents qui travaillent pendant que vous êtes en rendez-vous.",
    points: [
      'Subagents : des experts au contexte isolé, qui travaillent en parallèle',
      'Commandes personnalisées : orchestrer une veille concurrentielle publiée dans Notion',
      'Routines : planifiées ou déclenchées par un événement, ordinateur éteint',
      "Gouvernance d'équipe : responsable du plugin, droits d'accès, consommation",
    ],
  },
];

const modalities = [
  { label: 'Durée', value: '1 journée (7 heures)' },
  { label: 'Format', value: "Présentiel dans vos locaux, jusqu'à 10 participants" },
  {
