  },
  {
    title: 'Automatiser ses workflows avec des agents',
    body:
      'orchestrer des subagents par une commande personnalisée et la faire tourner en autonomie avec une routine.',
  },
];

/** Programme : un bloc par objectif, dans l'ordre des trois séquences de la journée. */
const modules = [
  {
    number: '01',
    title: 'Configurer et piloter Claude Code',
    intro:
