  },
  {
    title: 'Intégrer des équipes pluridisciplinaires dans le process de Discovery',
    body:
      "favoriser une meilleure collaboration et compréhension au sein de l'équipe en adoptant un vocabulaire partagé, essentiel pour une communication efficace et un alignement stratégique.",
  },
];

/** Le programme reprend les quatre objectifs, un bloc par objectif. */
const modules = objectives.map((o, i) => ({
  number: String(i + 1).padStart(2, '0'),
  title: o.title,
