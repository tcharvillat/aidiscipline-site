import TrainingDayLayout from '../../layouts/TrainingDayLayout.astro';

const TITLE = 'Product Discovery — FOCUSED';

const objectives = [
  {
    title: 'Identifier les bons problèmes à résoudre',
    body:
      "cibler les défis stratégiques et les besoins utilisateurs essentiels qui méritent l'attention et les ressources de l'équipe.",
  },
  {
    title: 'Savoir dérisquer ses décisions produit',
    body:
      "anticiper, identifier et atténuer les risques associés aux choix de produit, afin d'augmenter les chances de succès sur le marché.",
  },
  {
    title: 'Maîtriser les livrables de la méthode FOCUSED',
