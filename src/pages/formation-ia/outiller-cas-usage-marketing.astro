const audienceText =
  "Cette formation s'adresse aux équipes marketing qui ont suivi la formation GenAI - Les Fondamentaux et veulent appliquer l'IA générative à leurs propres cas d'usage. Chaque participant vient avec ses progrès, ses questions et ses points bloquants, et repart avec une solution concrète, réutilisable dans son quotidien dès le lendemain.";

const seoDescription =
