      'Test de la solution sur un cas réel',
      'Analyse des résultats et ajustements',
      "Mise en forme de la solution pour la réutiliser et la partager avec l'équipe",
      'Mise en pratique et échanges',
    ],
  },
];

const modalities = [
  { label: 'Durée', value: '1 demi-journée' },
