---
/**
 * Page de référence pour les futurs intervenants (formateurs indépendants).
 * Page statique : elle liste les éléments du dossier à envoyer par email.
 * Partagée par lien, hors menu et non indexée.
 * Tout le contenu vient de src/data/intervenants.json.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import QualiopiBadge from '../components/ui/QualiopiBadge.astro';
import data from '../data/intervenants.json';

---

<BaseLayout title={data.seo.title} description={data.seo.description} noindex>
  <Header />

  <main>
    <!-- a. Hero -->
    <section class="bg-surface-secondary">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center gap-10 px-6 py-14 md:px-8 md:py-20 lg:flex-row lg:items-center lg:gap-16 lg:px-12"
      >
        <div class="flex-1 text-center lg:text-left">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-500">
            Formateurs indépendants
          </p>
          <h1 class="mt-3 text-display-xl font-bold text-ink">{data.hero.title}</h1>
          <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-ink-muted md:text-lg lg:mx-0">
            {data.hero.subtitle}
          </p>
        </div>
        <div class="shrink-0">
          <QualiopiBadge compact />
        </div>
      </div>
    </section>

    <!-- b. Votre parcours -->
    <section aria-labelledby="parcours-title">
      <div class="mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24 lg:px-12">
        <h2 id="parcours-title" class="text-display-lg font-bold text-ink">Votre parcours</h2>
        <ol class="relative mt-10 grid gap-8 lg:grid-cols-4 lg:gap-6">
          {
            data.parcours.map((etape, i) => (
              <li class="relative flex gap-5 lg:flex-col lg:gap-4">
                {/* Trait de liaison : vertical sur mobile, horizontal sur desktop */}
                {i < data.parcours.length - 1 && (
                  <span
                    aria-hidden="true"
                    class="absolute left-6 top-12 -bottom-8 w-px bg-brand-200 lg:left-12 lg:right-[-1.5rem] lg:top-6 lg:bottom-auto lg:h-px lg:w-auto"
                  />
                )}
                <span class="relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-500 text-sm font-bold text-white">
                  {etape.step}
                </span>
                <div>
                  <h3 class="text-lg font-semibold text-ink">{etape.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-ink-muted">{etape.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- c. Les éléments à nous transmettre -->
    <section aria-labelledby="elements-title" class="bg-surface-secondary">
      <div class="mx-auto max-w-4xl px-6 py-16 md:px-8 md:py-24 lg:px-12">
        <h2 id="elements-title" class="text-display-lg font-bold text-ink">
          Les éléments à nous transmettre
        </h2>
        <p class="mt-4 flex items-center gap-2 text-sm text-ink-muted">
          <svg class="h-4 w-4 shrink-0 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
          </svg>
          Pièce jointe à ajouter à votre email
        </p>

        <div class="mt-10 space-y-12">
          {
            data.categories.map((cat) => (
              <div>
                <h3 class="text-display-md font-semibold text-ink">{cat.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">{cat.why}</p>
                <ul class="mt-6 space-y-4">
                  {cat.items.map((item) => (
                    <li
                      id={'anchor' in item ? item.anchor : undefined}
                      class="scroll-mt-24 rounded-2xl bg-white p-5 shadow-card md:p-6"
                    >
                      <div class="flex flex-wrap items-start justify-between gap-3">
                        <p class="flex items-start gap-2 font-semibold text-ink">
                          {item.attachment && (
                            <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Pièce jointe">
                              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                              <polyline points="14 2 14 8 20 8" />
                            </svg>
                          )}
                          <span>{item.label}</span>
                        </p>
                        {item.required ? (
                          <span class="shrink-0 rounded-pill bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">
                            Obligatoire
                          </span>
                        ) : (
                          <span class="shrink-0 rounded-pill bg-gray-100 px-3 py-1 text-xs font-semibold text-ink-muted">
                            Facultatif
                          </span>
                        )}
                      </div>
                      <p class="mt-2 text-sm leading-relaxed text-ink-muted">{item.detail}</p>
                      {'link' in item && item.link && (
                        <a
                          href={item.link.href}
                          class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand-700 underline-offset-2 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
                        >
                          {item.link.label} <span aria-hidden="true">↓</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- À faire dans les prochains jours -->
    <section aria-labelledby="todo-title">
      <div class="mx-auto max-w-4xl px-6 py-16 md:px-8 md:py-20 lg:px-12">
        <h2 id="todo-title" class="text-display-lg font-bold text-ink">{data.todo.title}</h2>
        <p class="mt-4 leading-relaxed text-ink-muted">{data.todo.why}</p>

        <div class="mt-8 rounded-2xl bg-white p-6 shadow-card md:p-8">
          <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
            <div class="flex items-start gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-brand-700" aria-hidden="true">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 10 12 5 2 10l10 5 10-5z" />
                  <path d="M6 12v5c3 2 9 2 12 0v-5" />
                </svg>
              </span>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-brand-500">{data.todo.course.label}</p>
                <h3 class="mt-1 text-lg font-semibold text-ink">{data.todo.course.title}</h3>
              </div>
            </div>
            <div class="shrink-0">
              <Button href={data.todo.course.url} withArrow ariaLabel={`${data.todo.course.ctaLabel} (nouvel onglet)`}>
                {data.todo.course.ctaLabel}
              </Button>
            </div>
          </div>

          <ol class="mt-8 space-y-4 border-t border-gray-100 pt-6">
            {
              data.todo.steps.map((step) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 h-5 w-5 shrink-0 rounded-md border-2 border-brand-300" aria-hidden="true" />
                  <p class="leading-relaxed text-ink">{step}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- f. Nos engagements réciproques -->
    <section aria-labelledby="engagements-title" class="bg-surface-secondary">
      <div class="mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24 lg:px-12">
        <h2 id="engagements-title" class="text-display-lg font-bold text-ink">
          Nos engagements réciproques
        </h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {
            data.engagements.map((e) => (
              <article class="rounded-2xl bg-white p-6 shadow-card">
                <h3 class="text-lg font-semibold text-brand-700">{e.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-muted">{e.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- d. Numéro de déclaration d'activité -->
    <section id="obtenir-nda" aria-labelledby="nda-title" class="scroll-mt-24">
      <div class="mx-auto max-w-4xl px-6 py-16 md:px-8 md:py-24 lg:px-12">
        <div class="rounded-2xl border-2 border-brand-200 bg-white p-6 md:p-10">
          <h2 id="nda-title" class="text-display-md font-bold text-ink">{data.nda.title}</h2>
          <p class="mt-4 leading-relaxed text-ink-muted">{data.nda.intro}</p>
          <ol class="mt-8 space-y-5">
            {
              data.nda.steps.map((step, i) => (
                <li class="flex gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700">
                    {i + 1}
                  </span>
                  <p class="pt-1 leading-relaxed text-ink">{step}</p>
                </li>
              ))
            }
          </ol>
          <div class="mt-8">
            <Button href={data.nda.ctaUrl} withArrow ariaLabel={`${data.nda.ctaLabel} (nouvel onglet)`}>
              {data.nda.ctaLabel}
            </Button>
          </div>
          <p class="mt-8 rounded-xl bg-surface-secondary p-5 text-sm leading-relaxed text-ink">
            <strong class="font-semibold">Délai :</strong>
            {data.nda.deadline}
          </p>
          <a
            href={data.nda.backHref}
            class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-brand-700 underline-offset-2 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          >
            <span aria-hidden="true">↑</span> {data.nda.backLabel}
          </a>
        </div>
      </div>
    </section>

    <!-- g. Bloc final -->
    <section aria-labelledby="cta-title" class="bg-surface-dark text-white">
      <div class="mx-auto max-w-3xl px-6 py-16 text-center md:px-8 md:py-20 lg:px-12">
        <h2 id="cta-title" class="text-display-lg font-bold">{data.cta.title}</h2>
        <p class="mx-auto mt-4 max-w-xl leading-relaxed text-white/80">{data.cta.body}</p>
        <div class="mx-auto mt-8 max-w-md rounded-2xl border border-white/15 bg-white/5 px-6 py-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-300">{data.cta.emailLabel}</p>
          <p class="mt-2 select-all break-all text-xl font-bold text-white md:text-2xl">{data.dossierEmail}</p>
          <p class="mt-3 text-sm text-white/70">{data.cta.subjectLabel} « {data.dossierEmailSubject} »</p>
        </div>
        <p class="mt-6 text-sm text-white/80">{data.cta.contactText}</p>
      </div>
    </section>

    <!-- h. Données personnelles (RGPD) -->
    <section aria-labelledby="rgpd-title" class="border-t border-white/10 bg-surface-dark text-white">
      <div class="mx-auto max-w-6xl px-6 py-12 md:px-8 lg:px-12">
        <h2 id="rgpd-title" class="text-base font-semibold text-white">{data.rgpd.title}</h2>
        <div class="mt-3 space-y-3 text-sm leading-relaxed text-white/70">
          {data.rgpd.paragraphs.slice(0, -1).map((para) => <p>{para}</p>)}
          <p>
            {data.rgpd.paragraphs[data.rgpd.paragraphs.length - 1]}{' '}
            <strong class="font-semibold text-white">{data.rgpd.email}</strong>. {data.rgpd.cnil}
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
