---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const CONTACT_EMAIL = 'hello@aidiscipline.com';
---

<BaseLayout
  title="Mentions légales — AI Discipline"
  description="Mentions légales du site aidiscipline.com, édité par Discovery Discipline SAS : éditeur, hébergeur, propriété intellectuelle et données personnelles."
>
  <Header />

  <main>
    <section class="bg-surface-secondary">
      <div class="mx-auto max-w-4xl px-6 py-14 text-center md:px-8 md:py-20 lg:px-12">
        <h1 class="text-display-xl font-bold text-ink">Mentions légales</h1>
      </div>
    </section>

    <section>
      <div class="mx-auto max-w-3xl space-y-12 px-6 py-16 md:px-8 md:py-20 lg:px-12">
        <article class="space-y-4">
          <h2 class="text-2xl font-semibold text-ink">Éditeur du site</h2>
          <ul class="space-y-1.5 text-base leading-relaxed text-ink-muted">
            <li><span class="font-semibold text-ink">DISCOVERY DISCIPLINE</span> — SAS au capital de 10 000 €</li>
            <li>RCS Paris : 912 638 533</li>
            <li>SIRET : 912 638 533 00014</li>
            <li>Numéro de TVA intracommunautaire : FR13912638533</li>
            <li>Siège social : 18 boulevard Arago, 75013 Paris, France</li>
            <li>Représentants légaux : Tristan Charvillat et Rémi Guyot</li>
            <li>
              Email :
              <a href={`mailto:${CONTACT_EMAIL}`} class="text-brand-500 hover:underline">
                {CONTACT_EMAIL}
              </a>
            </li>
            <li>Déclaration d'activité n°11756928875 auprès du préfet de la région Île-de-France</li>
          </ul>
        </article>

        <article class="space-y-4">
          <h2 class="text-2xl font-semibold text-ink">Hébergeur du site</h2>
          <p class="text-base leading-relaxed text-ink-muted">Le site est hébergé par :</p>
          <ul class="space-y-1.5 text-base leading-relaxed text-ink-muted">
            <li><span class="font-semibold text-ink">Vercel Inc.</span></li>
            <li>Adresse : 440 N Barranca Ave #4133, Covina, CA 91723, États-Unis</li>
            <li>
              Site web :
              <a
                href="https://vercel.com"
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-500 hover:underline"
              >
                vercel.com
              </a>
            </li>
          </ul>
        </article>

        <article class="space-y-4">
          <h2 class="text-2xl font-semibold text-ink">Propriété intellectuelle</h2>
          <p class="text-base leading-relaxed text-ink-muted">
            L'ensemble du contenu du site www.aidiscipline.com (textes, images,
            vidéos, logos, documents téléchargeables, etc.) est protégé par le
            droit d'auteur et demeure la propriété exclusive de DISCOVERY
            DISCIPLINE, sauf mention contraire. Toute reproduction ou
            utilisation non autorisée est interdite.
          </p>
        </article>

        <article class="space-y-4">
          <h2 class="text-2xl font-semibold text-ink">Données personnelles</h2>
          <p class="text-base leading-relaxed text-ink-muted">
            Vous pouvez exercer vos droits d'accès, de rectification ou de
            suppression de vos données personnelles en nous contactant à :
            <a href={`mailto:${CONTACT_EMAIL}`} class="text-brand-500 hover:underline">
              {CONTACT_EMAIL}
            </a>
          </p>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
