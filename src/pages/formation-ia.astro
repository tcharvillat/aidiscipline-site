---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import DayTrainingCard from '../components/ui/DayTrainingCard.astro';
import CategoryNav from '../components/ui/CategoryNav.astro';
import TestimonialCard from '../components/ui/TestimonialCard.astro';

import teamTrainingsData from '../data/team-trainings.json';
import testimonialsData from '../data/testimonials.json';

const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xqenknrz';

const testimonials = testimonialsData.testimonials;

// Formations d'une journée, regroupées par catégorie (ordre du JSON).
type CategoryKey = keyof typeof teamTrainingsData.categories;
const teamCategories = (
  Object.keys(teamTrainingsData.categories) as CategoryKey[]
)
  .map((key) => ({
    key,
    ...teamTrainingsData.categories[key],
    trainings: teamTrainingsData.trainings.filter((t) => t.category === key),
  }))
  .filter((c) => c.trainings.length > 0);
---

<BaseLayout
  title="Formations IA en ligne — AI Discipline"
  description="Formations IA en ligne pour équipes Produit & Design : 1 heure live par semaine, exercices individualisés, certificat et garantie Maven."
>
  <Header />

  <main>
    <!-- Hero ------------------------------------------------------------- -->
    <section class="bg-surface-secondary">
      <div class="mx-auto max-w-5xl px-6 py-14 text-center md:px-8 md:py-20 lg:px-12">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-500">
          Les cours en ligne — AI Discipline
        </p>
        <h1 class="mt-5 text-display-xl font-bold text-ink">
          L'IA enseignée par ceux qui la <span class="text-brand-500">pratiquent</span>.
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-ink-muted">
          Une journée pour passer à la pratique sur un sujet métier, en
          intra-entreprise. Le programme s'adapte à vos outils, vos cas
          d'usage et au niveau de votre équipe.
        </p>
      </div>
    </section>

    <!-- Formations d'une journée ---------------------------------------- -->
    <section class="bg-surface-secondary [--section-bg:#FFF0F8]">
      <CategoryNav
        categories={teamCategories.map((c) => ({
          key: c.key,
          label: c.label,
          color: c.color,
          count: c.trainings.length,
        }))}
      />

      <div class="mx-auto max-w-7xl px-6 pt-12 pb-20 md:px-8 md:pb-24 lg:px-12">
        <div class="space-y-14">
          {teamCategories.map((category) => (
            <div id={`cat-${category.key}`} class="scroll-mt-[164px] md:scroll-mt-[172px]">
              <h2 class="mb-8 flex items-center gap-3 text-2xl font-semibold uppercase tracking-wide md:text-3xl text-ink">
                <span
                  class="h-3 w-3 shrink-0 rounded-full md:h-3.5 md:w-3.5"
                  style={`background: ${category.color}`}
                  aria-hidden="true"
                ></span>
                {category.label}
              </h2>
              <div class="grid gap-x-6 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
                {category.trainings.map((t) => (
                  <DayTrainingCard
                    title={t.title}
                    categoryLabel={category.label}
                    categoryColor={category.color}
                    tags={'tags' in t ? t.tags : undefined}
                    objectives={t.objectives}
                  />
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials ----------------------------------------------------- -->
    <section>
      <div class="mx-auto max-w-7xl px-6 py-20 md:px-8 md:py-24 lg:px-12">
        <div class="mb-12 max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-500">
            Témoignages
          </p>
          <h2 class="mt-3 text-4xl font-light leading-tight text-ink md:text-5xl">
            Ils parlent de nos formations
          </h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {testimonials.map((t) => (
            <TestimonialCard
              quote={t.quote}
              author={t.author}
              role={t.role}
              company={t.company}
              photo={t.photo}
              companyLogo={t.companyLogo}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Contact form ----------------------------------------------------- -->
    <section id="contact" class="scroll-mt-20 bg-surface-secondary">
      <div class="mx-auto max-w-3xl px-6 py-20 md:px-8 md:py-24 lg:px-12">
        <div class="mb-10 text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-500">
            Contact
          </p>
          <h2 class="mt-3 text-4xl font-light leading-tight text-ink md:text-5xl">Nous contacter</h2>
          <p class="mx-auto mt-4 max-w-xl text-base text-ink-muted">
            Une question sur une formation, ou envie d'organiser une session
            pour votre équipe ? Écrivez-nous, nous reviendrons vers vous
            rapidement.
          </p>
        </div>

        <form
          action={FORMSPREE_ENDPOINT}
          method="POST"
          class="space-y-5 rounded-2xl bg-white p-6 shadow-card md:p-8"
        >
          <div class="grid gap-5 md:grid-cols-2">
            <div>
              <label for="firstname" class="block text-sm font-medium text-ink">
                Prénom <span class="text-brand-500">*</span>
              </label>
              <input
                id="firstname"
                name="firstname"
                type="text"
                required
                class="mt-2 block w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-ink placeholder-ink-light focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
              />
            </div>
            <div>
              <label for="lastname" class="block text-sm font-medium text-ink">
                Nom <span class="text-brand-500">*</span>
              </label>
              <input
                id="lastname"
                name="lastname"
                type="text"
                required
                class="mt-2 block w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-ink placeholder-ink-light focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-ink">
              E-mail <span class="text-brand-500">*</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="mt-2 block w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-ink placeholder-ink-light focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
            />
          </div>

          <div>
            <label for="company" class="block text-sm font-medium text-ink">
              Société
            </label>
            <input
              id="company"
              name="company"
              type="text"
              class="mt-2 block w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-ink placeholder-ink-light focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-ink">
              Votre message <span class="text-brand-500">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="mt-2 block w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-ink placeholder-ink-light focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
            ></textarea>
          </div>

          <div class="pt-2">
            <Button type="submit" variant="primary" size="lg" withArrow>
              Envoyer
            </Button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
