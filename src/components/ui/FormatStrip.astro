---
import formatData from '../../data/format-points.json';

const { points } = formatData;
---

<!-- Format des formations : 4 points en ligne, séparés par de fins traits -->
<div class="format-strip border-y border-[#F3C9DD] py-8 md:py-10">
  <ul class="grid md:grid-cols-2 lg:grid-cols-4">
    {points.map((point) => (
      <li class="format-item px-6 py-5 text-center lg:py-0">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white text-brand-500 shadow-[0_4px_14px_rgba(252,3,126,0.12)]">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {point.icon === 'location' && (
              <>
                <path d="M3 21h18M5 21V7l7-4 7 4v14" />
                <path d="M9 21v-6h6v6M9 10h.01M15 10h.01" />
              </>
            )}
            {point.icon === 'tools' && (
              <>
                <rect x="3" y="4" width="18" height="12" rx="2" />
                <path d="M8 20h8M12 16v4M8 9l2 2-2 2M13 13h3" />
              </>
            )}
            {point.icon === 'target' && (
              <>
                <circle cx="12" cy="12" r="9" />
                <circle cx="12" cy="12" r="5" />
                <circle cx="12" cy="12" r="1" />
              </>
            )}
            {point.icon === 'certificate' && (
              <>
                <circle cx="12" cy="9" r="6" />
                <path d="M9 14.5V21l3-2 3 2v-6.5" />
              </>
            )}
          </svg>
        </span>
        <p class="mt-4 text-[15px] font-bold text-ink">{point.title}</p>
        <p class="mt-2 text-[13px] leading-relaxed text-ink-muted">{point.body}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Traits de séparation : horizontaux sur mobile, verticaux dès 2 colonnes */
  .format-item + .format-item {
    border-top: 1px solid #f3c9dd;
  }
  @media (min-width: 768px) {
    .format-item + .format-item {
      border-top: 0;
    }
    .format-item:nth-child(even) {
      border-left: 1px solid #f3c9dd;
    }
  }
  @media (min-width: 1024px) {
    .format-item + .format-item {
      border-left: 1px solid #f3c9dd;
    }
  }
</style>
