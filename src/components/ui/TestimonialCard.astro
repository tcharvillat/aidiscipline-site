---
export interface Props {
  quote: string;
  author: string;
  role?: string;
  company?: string;
  photo?: string | null;
}

const { quote, author, role, company, photo } = Astro.props;

const initials = author
  .split(' ')
  .map((part) => part[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<!-- Carte du mur de citations : la personne d'abord, puis sa citation en entier -->
<figure class="mb-5 break-inside-avoid rounded-[18px] border border-gray-100 bg-[#FAFAFC] p-6">
  <figcaption class="flex items-center gap-3 border-b border-gray-100 pb-4">
    {photo ? (
      <img
        src={photo}
        alt={`Portrait de ${author}`}
        class="h-[52px] w-[52px] flex-shrink-0 rounded-full object-cover"
        loading="lazy"
        width="52"
        height="52"
      />
    ) : (
      <div
        class="flex h-[52px] w-[52px] flex-shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-semibold text-brand-700"
        aria-hidden="true"
      >
        {initials}
      </div>
    )}
    <div class="min-w-0 flex-1">
      <p class="text-[15px] font-bold text-ink">{author}</p>
      {role && <p class="mt-0.5 text-sm font-semibold text-ink">{role}</p>}
      {company && (
        <p class:list={['text-ink-light', role ? 'text-[12.5px]' : 'mt-0.5 text-sm']}>{company}</p>
      )}
    </div>
    <span
      class="h-[34px] self-start text-[64px] font-extrabold leading-none text-brand-500"
      aria-hidden="true"
    >“</span>
  </figcaption>

  <blockquote class="mt-4">
    <p class="text-[15px] leading-relaxed text-ink">{quote}</p>
  </blockquote>
</figure>
