---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'AI Discipline — Formations IA pour équipes Produit & Design.',
  ogImage = '/images/brand/og-default.jpg',
  canonicalURL,
  noindex = false,
} = Astro.props;

const canonical =
  canonicalURL ?? new URL(Astro.url.pathname, Astro.site).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://www.aidiscipline.com/#organization',
  name: 'AI Discipline',
  legalName: 'Discovery Discipline SAS',
  url: 'https://www.aidiscipline.com',
  logo: 'https://www.aidiscipline.com/images/brand/logo.png',
  email: 'hello@aidiscipline.com',
  vatID: 'FR13912638533',
  taxID: '912 638 533 00014',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '18 boulevard Arago',
    postalCode: '75013',
    addressLocality: 'Paris',
    addressCountry: 'FR',
  },
  founder: [
    { '@type': 'Person', name: 'Tristan Charvillat' },
    { '@type': 'Person', name: 'Rémi Guyot' },
  ],
  sameAs: [
    'https://www.linkedin.com/company/ai-discipline/',
    'https://maven.com/aidiscipline',
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FC037E" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI Discipline" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI Discipline — Formations IA pour équipes Produit & Design" />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-white text-ink antialiased">
    <slot />
  </body>
</html>
