---
/**
 * Template des pages « formation sur mesure » (une journée en intra-entreprise).
 * Utilisé par /formation-ia/fondamentaux et par les fiches /formation-ia/[slug].
 * Seuls le programme, les objectifs et le SEO varient ; le reste de la page
 * (indicateurs, témoignages, modalités, OPCO, contact) est commun.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Button from '../components/ui/Button.astro';
import TestimonialCard from '../components/ui/TestimonialCard.astro';
import QualiopiBadge from '../components/ui/QualiopiBadge.astro';

export interface Module {
  number: string;
  title: string;
  /** Phrase d'accroche du module (facultative). */
  intro?: string;
  /** Points abordés dans le module (facultatifs). */
  points?: string[];
}

export interface Objective {
  title: string;
  /** Détail affiché après un tiret (facultatif). */
  body?: string;
}

export interface Props {
  seoTitle: string;
  seoDescription: string;
  /** Titre principal (h1) du bloc programme. */
  heading: string;
  /** Garde le h1 sur une ligne en desktop (titres courts uniquement). */
  headingNoWrap?: boolean;
  modules: Module[];
  objectives: Objective[];
  indicatorsHeading?: string;
  /** Données structurées schema.org (Course). */
  courseSchema: Record<string, unknown>;
  /** Paragraphe d'accroche sous le h1 (facultatif). */
  lead?: string;
  /** Exclut la page des moteurs de recherche (page pas encore publiée). */
  noindex?: boolean;
  /** Surcharges des blocs communs ; par défaut, contenu des formations IA. */
  audienceHeading?: string;
  audienceText?: string;
  /** Liste vide : la section des indicateurs est masquée. */
  indicators?: Indicator[];
  /** Liste vide : la section des témoignages est masquée. */
  testimonials?: Testimonial[];
  modalities?: Modality[];
  pedagogy?: string[];
  evaluation?: string[];
}

export interface Indicator {
  label: string;
  value: string;
  unit: string;
}

export interface Testimonial {
  quote: string;
  author: string;
  role: string;
  company: string;
  photo?: string;
}

export interface Modality {
  label: string;
  value: string;
}

const {
  seoTitle,
  seoDescription,
  heading,
  headingNoWrap = false,
  modules,
  objectives,
  indicatorsHeading = 'Nos formations plébiscitées par les équipes',
  courseSchema,
  lead,
  noindex = false,
} = Astro.props;

const CALENDLY_URL = 'https://calendly.com/remi-guyot/30min';
const CONTACT_EMAIL = 'formation@aidiscipline.com';
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xqenknrz';
const REFERENT_EMAIL = 'tristan@discovery-discipline.com';

const defaultIndicators: Indicator[] = [
  { label: 'Satisfaction globale', value: '9,2', unit: '/10' },
  { label: "Qualité de l'animation", value: '9,6', unit: '/10' },
  { label: 'Recommandation', value: '91', unit: '%' },
];

const defaultTestimonials: Testimonial[] = [
  {
    quote:
      "Une formation sans langue de bois, qui délivre du concret et de la valeur aux équipes.",
    author: 'Julien Clément',
    role: 'Global Head of Design',
    company: 'Carrefour',
    photo: '/images/testimonials/julien-clement.jpg',
  },
  {
    quote:
      "Une formation actionnable pour construire une bonne base de compétences et de réflexion, nécessaire à une prise en main de la GenAI de la bonne manière : réfléchie, intentionnelle et scalable pour les équipes.",
    author: 'Sophie Pesenti',
    role: 'Group Product Manager',
    company: 'Decathlon',
  },
  {
    quote:
      "Tristan et Rémi ont une connaissance approfondie et pratique de l'IA qui fait de cette formation un vrai tremplin pour les managers qui souhaitent augmenter leurs équipes. Je recommande les yeux fermés.",
    author: 'Geoffroy de La Rochebrochard',
    role: 'Product Director',
    company: 'Pluxee',
  },
  {
    quote:
      "Format efficace, échanges stimulants et mise en pratique simple ! Parfait pour embarquer ses équipes et leur donner envie de s'y mettre.",
    author: 'Alicia Carb',
    role: 'Chief Product Officer',
    company: 'Barrière',
  },
  {
    quote:
      "Une bonne formation pour démystifier l'IA, apprendre à prompter et créer notre propre assistant. Une formation dynamique et inspirante pour nos équipes !",
    author: 'Virginie Lacloche',
    role: 'Directrice Marketing',
    company: 'Carrefour',
  },
  {
    quote:
      "Une formation excellente, à la fois sur le fond et sur la forme. L'équipe en est ressortie pleine d'énergie avec l'envie d'avancer.",
    author: 'Vincent Fonade',
    role: 'Chief People Officer',
    company: 'Eurecia',
  },
];

const defaultModalities: Modality[] = [
  { label: 'Durée', value: '1 journée (7 heures)' },
  { label: 'Format', value: 'Présentiel dans vos locaux' },
  {
    label: 'Public',
    value: 'Équipes Produit, Design, Marketing, RH, Management et CODIR',
  },
  {
    label: 'Pré-requis',
    value:
      'Aucun pré-requis technique. Ordinateur portable et connexion internet haut débit requis.',
  },
  {
    label: 'Accessibilité',
    value:
      'Formation accessible aux personnes en situation de handicap. Contacter le référent handicap en amont.',
  },
  { label: 'Tarif', value: 'à partir de 6 000 € HT' },
  {
    label: "Délai d'accès",
    value:
      '7 jours ouvrés minimum à compter de la validation de la convention.',
  },
];

const defaultAudienceText =
  "Nos formations s'adaptent à la réalité et aux besoins de chaque organisation. Les fondamentaux du prompting et de la conception d'assistants IA constituent un socle commun à toutes les équipes — Produit, Design, Marketing, Data, ou encore RH. Ce qui change, ce sont les cas d'usage explorés, les outils mobilisés et les exemples concrets appliqués à chaque métier. Nous concevons ainsi des parcours sur mesure qui parlent le langage de vos équipes et leur permettent d'intégrer l'IA dans leur quotidien, de façon pertinente, durable et alignée avec vos enjeux.";

const defaultPedagogy = [
  "Alternance d'exposés théoriques et d'exercices pratiques adaptés au contexte métier de chaque participant.",
  'Tour de table en début de journée pour recueillir les attentes spécifiques de chaque participant.',
  "Mise en pratique sur les outils IA déployés dans l'organisation (Dust, Copilot, Gemini ou outils internes).",
  'Exercice fil conducteur : chaque participant configure et teste son propre assistant IA au fil de la journée.',
];

const defaultEvaluation = [
  'Un test de positionnement est réalisé en amont de la formation pour évaluer le niveau initial de chaque participant.',
  'Un test de validation des acquis est réalisé en fin de journée.',
  'Un certificat de formation est délivré aux participants ayant réussi le test de certification.',
  "Une feuille d'émargement est signée par chaque participant tout au long de la journée.",
];

const {
  audienceHeading = 'Quelles équipes former ?',
  audienceText = defaultAudienceText,
  indicators = defaultIndicators,
  testimonials = defaultTestimonials,
  modalities = defaultModalities,
  pedagogy = defaultPedagogy,
  evaluation = defaultEvaluation,
} = Astro.props;
---

<BaseLayout title={seoTitle} description={seoDescription} noindex={noindex}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <Header minimal />

  <main>
    <!-- Modules ---------------------------------------------------------- -->
    <section id="programme" class="bg-surface-secondary scroll-mt-24">
      <div class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-24 lg:px-12">
        <div class="mb-12">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-500">
            Programme
          </p>
          <h1
            class:list={[
              'mt-3 text-4xl font-light leading-tight text-ink md:text-4xl lg:text-5xl',
              headingNoWrap && 'lg:whitespace-nowrap',
            ]}
          >
            {heading}
          </h1>
          {lead && (
            <p class="mt-6 max-w-3xl text-base leading-relaxed text-ink-muted md:text-lg">
              {lead}
            </p>
          )}
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          {modules.map((m) => (
            <article class="flex flex-col rounded-2xl bg-white p-8 shadow-card">
              <h3 class="text-xl font-bold text-ink">{m.title}</h3>
              {m.intro && (
                <p class="mt-4 flex gap-2 text-sm leading-relaxed text-ink-muted">
                  <span aria-hidden="true">👉</span>
                  <span>{m.intro}</span>
                </p>
              )}
              {m.points && m.points.length > 0 && (
                <ul class="mt-5 space-y-2 border-t border-gray-100 pt-5">
                  {m.points.map((point) => (
                    <li class="flex gap-2 text-sm text-ink">
                      <span class="mt-1.5 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Indicateurs ------------------------------------------------------ -->
    {indicators.length > 0 && (
    <section class="bg-ink text-white">
      <div class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-24 lg:px-12">
        <div class="mb-12 text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-300">
            Indicateurs de résultats
          </p>
          <h2 class="mt-3 text-4xl font-light leading-tight md:text-5xl">
            {indicatorsHeading}
          </h2>
        </div>

        <div class="grid gap-8 md:grid-cols-3">
          {indicators.map((ind) => (
            <div class="text-center">
              <p class="text-5xl font-bold text-brand-400 md:text-6xl">
                {ind.value}<span class="text-3xl text-white/70 md:text-4xl">{ind.unit}</span>
              </p>
              <p class="mt-3 text-sm font-medium uppercase tracking-wider text-white/70">
                {ind.label}
              </p>
            </div>
          ))}
        </div>

        <p class="mt-12 text-center text-xs text-white/50">
          Mise à jour avril 2026
        </p>
      </div>
    </section>
    )}

    <!-- Audiences -------------------------------------------------------- -->
    <section>
      <div class="mx-auto max-w-4xl px-6 py-20 text-center md:px-8 md:py-24 lg:px-12">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-500">
          Public visé
        </p>
        <h2 class="mt-3 text-4xl font-light leading-tight text-ink md:text-5xl">
          {audienceHeading}
        </h2>
        <p class="mt-6 text-base leading-relaxed text-ink-muted">
          {audienceText}
        </p>
        <div class="mt-10 flex justify-center">
          <Button
            href={CALENDLY_URL}
            variant="primary"
            size="lg"
            external
            withArrow
          >
            Échanger sur votre projet
          </Button>
        </div>
      </div>
    </section>

    <!-- Testimonials ----------------------------------------------------- -->
    {testimonials.length > 0 && (
    <section class="bg-surface-secondary">
      <div class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-24 lg:px-12">
        <div class="mb-12 max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-500">
            Témoignages
          </p>
          <h2 class="mt-3 text-4xl font-light leading-tight text-ink md:text-5xl">
            Ils ont formé leurs équipes
          </h2>
        </div>

        <div class="columns-1 gap-5 md:columns-2 lg:columns-3">
          {testimonials.map((t) => (
            <TestimonialCard
              quote={t.quote}
              author={t.author}
              role={t.role}
              company={t.company}
              photo={t.photo}
            />
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- Modalités & infos formation (accordion exclusif) ----------------- -->
    <section>
      <div class="mx-auto max-w-4xl px-6 py-20 md:px-8 md:py-24 lg:px-12">
        <div class="mb-10 text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-500">
            Informations détaillées
          </p>
          <h2 class="mt-3 text-4xl font-light leading-tight text-ink md:text-5xl">
            Modalités, objectifs et accessibilité
          </h2>
        </div>

        <div class="space-y-3" data-accordion="formation-info">
          <details
            name="formation-info"
            class="group rounded-2xl border border-gray-200 bg-white transition-shadow open:border-brand-200 open:shadow-card"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left text-base font-semibold text-ink hover:text-brand-500">
              <span>Modalités</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-brand-500 transition-transform group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="border-t border-gray-100 px-6 py-5">
              <dl class="space-y-3 text-sm">
                {modalities.map((row) => (
                  <div class="flex flex-col gap-1 sm:flex-row sm:gap-2">
                    <dt class="font-semibold text-ink sm:w-40 sm:flex-shrink-0">
                      {row.label}
                    </dt>
                    <dd class="text-ink-muted">{row.value}</dd>
                  </div>
                ))}
                <div class="flex flex-col gap-1 sm:flex-row sm:gap-2">
                  <dt class="font-semibold text-ink sm:w-40 sm:flex-shrink-0">
                    Réservation
                  </dt>
                  <dd>
                    <a
                      href={`mailto:${CONTACT_EMAIL}`}
                      class="text-brand-500 hover:underline"
                    >
                      {CONTACT_EMAIL}
                    </a>
                  </dd>
                </div>
              </dl>
            </div>
          </details>

          <details
            name="formation-info"
            class="group rounded-2xl border border-gray-200 bg-white transition-shadow open:border-brand-200 open:shadow-card"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left text-base font-semibold text-ink hover:text-brand-500">
              <span>Objectifs pédagogiques</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-brand-500 transition-transform group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="border-t border-gray-100 px-6 py-5">
              <p class="mb-4 text-sm text-ink-muted">
                À l'issue de la formation, chaque participant sera capable de :
              </p>
              <ul class="space-y-3">
                {objectives.map((obj) => (
                  <li class="flex gap-2 text-sm leading-relaxed">
                    <span class="mt-1.5 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
                    {obj.body ? (
                      <span>
                        <span class="font-semibold text-ink">{obj.title}</span>
                        <span class="text-ink-muted"> — {obj.body}</span>
                      </span>
                    ) : (
                      <span class="text-ink-muted">{obj.title}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </details>

          <details
            name="formation-info"
            class="group rounded-2xl border border-gray-200 bg-white transition-shadow open:border-brand-200 open:shadow-card"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left text-base font-semibold text-ink hover:text-brand-500">
              <span>Méthode pédagogique</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-brand-500 transition-transform group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="border-t border-gray-100 px-6 py-5">
              <ul class="space-y-3 text-sm leading-relaxed text-ink-muted">
                {pedagogy.map((item) => (
                  <li class="flex gap-2">
                    <span class="mt-1.5 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </details>

          <details
            name="formation-info"
            class="group rounded-2xl border border-gray-200 bg-white transition-shadow open:border-brand-200 open:shadow-card"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left text-base font-semibold text-ink hover:text-brand-500">
              <span>Évaluation des compétences acquises</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-brand-500 transition-transform group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="border-t border-gray-100 px-6 py-5">
              <ul class="space-y-3 text-sm leading-relaxed text-ink-muted">
                {evaluation.map((item) => (
                  <li class="flex gap-2">
                    <span class="mt-1.5 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </details>

          <details
            name="formation-info"
            class="group rounded-2xl border border-gray-200 bg-white transition-shadow open:border-brand-200 open:shadow-card"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left text-base font-semibold text-ink hover:text-brand-500">
              <span>Accessibilité et handicap</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-brand-500 transition-transform group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="border-t border-gray-100 px-6 py-5">
              <div class="space-y-4 text-sm leading-relaxed text-ink-muted">
                <p>
                  Cette formation est accessible aux personnes en situation de
                  handicap. Nous adaptons nos modalités pédagogiques en
                  fonction des besoins spécifiques de chaque participant.
                </p>
                <p>
                  Pour toute situation de handicap, merci de contacter notre
                  référent handicap en amont de la formation afin que nous
                  puissions étudier ensemble les aménagements nécessaires.
                </p>
                <p>
                  <span class="font-semibold text-ink">À consulter :</span>{' '}
                  <a
                    href="/accessibilite"
                    class="text-brand-500 hover:underline"
                  >
                    Politique d'accessibilité
                  </a>
                </p>
                <p>
                  <span class="font-semibold text-ink">Référent handicap :</span>{' '}
                  Tristan Charvillat —{' '}
                  <a
                    href={`mailto:${REFERENT_EMAIL}`}
                    class="text-brand-500 hover:underline"
                  >
                    {REFERENT_EMAIL}
                  </a>
                </p>
              </div>
            </div>
          </details>
        </div>
      </div>

      <script>
        // Fallback : sur les navigateurs qui ne supportent pas <details name=...>,
        // on force un comportement accordion (un seul ouvert à la fois).
        const group = document.querySelector('[data-accordion="formation-info"]');
        if (group) {
          const items = Array.from(
            group.querySelectorAll<HTMLDetailsElement>('details[name="formation-info"]'),
          );
          const supportsExclusive =
            'name' in HTMLDetailsElement.prototype;
          if (!supportsExclusive) {
            items.forEach((d) => {
              d.addEventListener('toggle', () => {
                if (d.open) {
                  items.forEach((other) => {
                    if (other !== d && other.open) other.open = false;
                  });
                }
              });
            });
          }
        }
      </script>
    </section>

    <!-- Financement OPCO ------------------------------------------------- -->
    <section class="bg-surface-secondary">
      <div class="mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-20 lg:px-12">
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div class="flex justify-center lg:justify-start">
            <QualiopiBadge compact={false} />
          </div>

          <div class="space-y-5">
            <h2 class="text-4xl font-light leading-tight text-ink md:text-5xl">
              Formation finançable par votre OPCO
            </h2>
            <p class="text-base leading-relaxed text-ink-muted">
              AI Discipline est certifié Qualiopi (Actions de formation). Nos
              formations sur mesure sont éligibles aux financements OPCO,
              France Travail et fonds publics de la formation professionnelle.
              Renseignez-vous auprès de votre service RH ou contactez-nous.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact form ----------------------------------------------------- -->
    <section class="bg-surface-secondary">
      <div class="mx-auto max-w-3xl px-6 py-20 md:px-8 md:py-24 lg:px-12">
        <div class="mb-10 text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-500">
            Contact
          </p>
          <h2 class="mt-3 text-4xl font-light leading-tight text-ink md:text-5xl">Nous contacter</h2>
          <p class="mx-auto mt-4 max-w-xl text-base text-ink-muted">
            Une question, un projet de formation pour vos équipes ? Écrivez-nous
            et nous reviendrons vers vous rapidement.
          </p>
        </div>

        <form
          action={FORMSPREE_ENDPOINT}
          method="POST"
          class="space-y-5 rounded-2xl bg-white p-6 shadow-card md:p-8"
        >
          <div class="grid gap-5 md:grid-cols-2">
            <div>
              <label for="firstname" class="block text-sm font-medium text-ink">
                Prénom <span class="text-brand-500">*</span>
              </label>
              <input
                id="firstname"
                name="firstname"
                type="text"
                required
                class="mt-2 block w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-ink placeholder-ink-light focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
              />
            </div>
            <div>
              <label for="lastname" class="block text-sm font-medium text-ink">
                Nom <span class="text-brand-500">*</span>
              </label>
              <input
                id="lastname"
                name="lastname"
                type="text"
                required
                class="mt-2 block w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-ink placeholder-ink-light focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-ink">
              E-mail <span class="text-brand-500">*</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="mt-2 block w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-ink placeholder-ink-light focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
            />
          </div>

          <div>
            <label for="company" class="block text-sm font-medium text-ink">
              Société
            </label>
            <input
              id="company"
              name="company"
              type="text"
              class="mt-2 block w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-ink placeholder-ink-light focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-ink">
              Votre message <span class="text-brand-500">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="mt-2 block w-full rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-ink placeholder-ink-light focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
            ></textarea>
          </div>

          <div class="pt-2">
            <Button type="submit" variant="primary" size="lg" withArrow>
              Envoyer
            </Button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
